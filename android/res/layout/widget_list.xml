<?xml version="1.0" encoding="utf-8"?>
<!-- static 2x1 list widget: label + rows rendered straight by updateAppWidget -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="4dp">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:paddingTop="2dp"
        android:paddingBottom="3dp"
        android:text=""
        android:textAllCaps="true"
        android:textColor="#9C96B3"
        android:textSize="9sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="4dp"
            android:text=""
            android:textColor="#9C96B3"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout android:id="@+id/row_1" style="@style/WidgetRow"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/row_icon_1" style="@style/WidgetRowIcon"
                android:layout_width="20dp" android:layout_height="wrap_content"
                android:minHeight="16dp" android:gravity="center" />
            <TextView android:id="@+id/row_name_1" style="@style/WidgetRowName"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row_2" style="@style/WidgetRow"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/row_icon_2" style="@style/WidgetRowIcon"
                android:layout_width="20dp" android:layout_height="wrap_content"
                android:minHeight="16dp" android:gravity="center" />
            <TextView android:id="@+id/row_name_2" style="@style/WidgetRowName"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row_3" style="@style/WidgetRow"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/row_icon_3" style="@style/WidgetRowIcon"
                android:layout_width="20dp" android:layout_height="wrap_content"
                android:minHeight="16dp" android:gravity="center" />
            <TextView android:id="@+id/row_name_3" style="@style/WidgetRowName"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row_4" style="@style/WidgetRow"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/row_icon_4" style="@style/WidgetRowIcon"
                android:layout_width="20dp" android:layout_height="wrap_content"
                android:minHeight="16dp" android:gravity="center" />
            <TextView android:id="@+id/row_name_4" style="@style/WidgetRowName"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
